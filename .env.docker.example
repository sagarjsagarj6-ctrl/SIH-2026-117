# =================================================================
# SOVEREIGN AI ENTERPRISE WORKBENCH - DOCKER ENVIRONMENT TEMPLATE
# Copy this file to .env before starting docker compose if customizing:
# cp .env.docker.example .env
# =================================================================

# Ports exposed to Host Machine
CLIENT_PORT=3000
SERVER_PORT=5001
MONGODB_PORT=27017
CLIENT_DEV_PORT=5173

# Security & Authentication Secret
# Generate a production key: openssl rand -hex 32
JWT_SECRET=sovereign_ai_enterprise_super_secret_jwt_key_2026

# Allowed CORS origins
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:80,http://localhost

# Local Inference Daemon (Host Ollama Pass-through)
# 'host.docker.internal' lets containers talk to Ollama running on your Windows/Mac/Linux host
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Fallback mode (Set true to allow graceful mock responses if local LLM is offline)
ALLOW_DETERMINISTIC_FALLBACK=true

# Alternative Local Inference Runtimes
VLLM_HOST=http://host.docker.internal:8000
LLAMACPP_HOST=http://host.docker.internal:8080

# Air-Gapped Network Enforcement
ALLOW_LAN_ONLY=true
AIRGAP_MODE=true

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
