# =================================================================
# SOVEREIGN AI ENTERPRISE WORKBENCH - CLIENT ENVIRONMENT TEMPLATE
# Copy to .env and configure for your deployment network.
# =================================================================

# Backend API Endpoint (Points to the Sovereign AI Express Server)
# Use /api in Vite development so the configured proxy handles localhost/127.0.0.1.
# For a separately hosted production client, replace this with the full API URL.
VITE_API_URL=/api

# Application Branding & Sovereign Security Level
VITE_APP_NAME="Sovereign AI Workbench"
VITE_SECURITY_MODE="AIR_GAPPED_ENTERPRISE"
