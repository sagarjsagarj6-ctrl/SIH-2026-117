# ===========================================
# SOVEREIGN AI WORKBENCH - LOCAL CONFIGURATION
# ===========================================
# This system is designed for PRIVACY-FIRST, AIR-GAPPED deployment
# NO external API calls - all inference stays on your machine
# ===========================================

# ===========================================
# LOCAL LLM BACKENDS (Choose One or More)
# ===========================================

# Option 1: Ollama (Recommended - Easiest setup)
# Download from: https://ollama.ai
# Start with: ollama serve
OLLAMA_HOST=http://127.0.0.1:11434
# Default model (optional): OLLAMA_MODEL=mistral

# Option 2: vLLM (High performance GPU inference)
# Start with: python -m vllm.entrypoints.openai.api_server --model mistralai/Mistral-7B-Instruct-v0.3
VLLM_HOST=http://localhost:8000

# Option 3: llama.cpp (GGUF model files)
# Download GGUF model and set path below
LLAMA_CPP_PATH=C:\models\your-model.gguf
LLAMA_CPP_N_CTX=4096

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=3001
NODE_ENV=development

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# SECURITY (IMPORTANT!)
# ===========================================
# Generate a secure secret for production:
# openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_SECRET_IN_PRODUCTION

# ===========================================
# DATABASE
# ===========================================
MONGODB_URI=mongodb://localhost:27017/sovereign_ai_workbench

# ===========================================
# OPTIONAL: Cloud Services (Not Required)
# ===========================================
# Only enable if you need external services
# LEAVE BLANK to maintain full privacy

# Pinecone Vector Database (Optional)
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=us-east-1

# ===========================================
# PRIVACY SETTINGS
# ===========================================
# These are enforced by default
# ENABLE_DEBUG_MODE=false  # Set true only for debugging
# ALLOW_EXTERNAL_APIS=false  # Never set true - privacy first

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info
