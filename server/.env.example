# =================================================================
# SOVEREIGN AI ENTERPRISE WORKBENCH - SERVER ENVIRONMENT TEMPLATE
# Copy to .env and configure for your local air-gap environment.
# =================================================================

# Server Port & Runtime Mode
PORT=5001
NODE_ENV=development
ALLOW_SELF_REGISTRATION=true

# Database Configuration (Local MongoDB with automatic In-Memory fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/sovereign_ai_db

# Security & Authentication (Air-Gapped Private Key - generate min 32 chars in production)
JWT_SECRET=your_secure_airgapped_jwt_secret_key_minimum_32_chars_long

# Local Inference Daemon Endpoints (Air-gapped LLM Backends)
OLLAMA_HOST=http://127.0.0.1:11434
VLLM_HOST=http://127.0.0.1:8000
LLAMACPP_HOST=http://127.0.0.1:8080

# Optional local neural embeddings (auto falls back to deterministic hash vectors)
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_MS=2500

# Optional live LoRA training runtime. Default auto uses simulation unless all are ready.
TRAINING_MODE=auto
TRAINING_PYTHON=python
TRAINING_MODEL_PATH=
LORA_TRAINER_SCRIPT=

# Optional real OCR runtime
TESSERACT_CMD=tesseract
TESSERACT_PSM=6

# Air-Gap & Network Isolation Enforcement
ALLOW_LAN_ONLY=true
AIRGAP_MODE=true
CLIENT_ORIGIN=http://localhost:5173

# Logging & Telemetry Level (debug, info, warn, error)
LOG_LEVEL=info

# Request body limits (file uploads remain capped at 50MB by the upload pipeline)
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
